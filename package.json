{
  "name": "tw-boilerplate",
  "version": "2.0.0",
  "private": true,
  "description": "Lightweight Nunjucks + Tailwind CSS static website boilerplate",
  "author": "Diki Siswanto",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs --production",
    "dev": "node scripts/dev.mjs",
    "watch": "node scripts/dev.mjs",
    "lint": "biome check scripts src/scripts",
    "format": "biome format --write scripts src/scripts",
    "format:check": "biome format scripts src/scripts",
    "validate": "node scripts/validate.mjs",
    "check": "npm run format:check && npm run lint && npm run validate && npm run build"
  },
  "devDependencies": {
    "@babel/cli": "8.0.4",
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.2",
    "html-validate": "11.12.0",
    "nunjucks": "3.2.4",
    "tailwindcss": "4.3.3"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ]
}
